diff --git a/examples/react/start-bare/src/routes/await-reject.tsx b/examples/react/start-bare/src/routes/await-reject.tsx
new file mode 100644
index 0000000..5c5dc07
--- /dev/null
+++ b/examples/react/start-bare/src/routes/await-reject.tsx
@@ -0,0 +1,15 @@
+import { Await, createFileRoute } from '@tanstack/react-router'
+
+export const Route = createFileRoute('/await-reject')({
+  loader: () => ({ deferred: Promise.reject() }),
+  component: AwaitReject,
+})
+
+function AwaitReject() {
+  const { deferred } = Route.useLoaderData()
+  return (
+    <Await promise={deferred} fallback={<div>waiting</div>}>
+      {() => <div>resolved</div>}
+    </Await>
+  )
+}
